# Private checklist. Leave the values empty in git.

CHECKLIST_PASSPHRASE=
CHECKLIST_SESSION_SECRET=

# Server-only. Do not prefix these with NEXT_PUBLIC.
# When both are unset, dev and tests use an in-memory store.
# Production shows "storage not configured" until they are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional first-run item list. Omit it and add items in the UI instead.
# Shape only — do not commit a real list:
# CHECKLIST_SEED_JSON=[{"id":"item-a","label":"Item A","category":"Body","order":0,"active":true,"publicStreak":false}]
CHECKLIST_SEED_JSON=

# Comma-separated item ids allowed to show a public streak. Empty means none.
# Money and private items are refused even if listed. The in-app toggle cannot publish.
CHECKLIST_PUBLIC_STREAK_IDS=
