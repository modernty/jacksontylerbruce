  "code": {
    "css": "/* Memory home — node 7188:1983 */\n:root {\n  --text-primary: #1a1f3c;\n  --text-secondary: #565c79;\n  --text-tertiary: #717794;\n  --neutral-700: #3d456b;\n  --bg-surface: #f5f6fa;\n  --bg-canvas: #ffffff;\n  --space-8: 8px;\n  --space-12: 12px;\n  --space-16: 16px;\n  --space-24: 24px;\n}\n\n.memory-title {\n  font: 600 24px/32px \"SF Pro Text\", -apple-system, sans-serif;\n  color: var(--text-primary);\n}\n\n.memory-intro {\n  font: 400 15px/22px \"SF Pro Text\", -apple-system, sans-serif;\n  color: var(--text-secondary);\n}\n\n/* \"What you've told PC Chat(TM)\" summary card */\n.memory-summary {\n  background: var(--bg-canvas);\n  border-radius: 24px;\n  padding: var(--space-16);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-12);\n}\n\n.memory-summary__heading {\n  font: 600 18px/28px \"SF Pro Text\", -apple-system, sans-serif;\n  color: var(--text-primary);\n}\n\n.memory-summary__body {\n  font: 400 15px/22px \"SF Pro Text\", -apple-system, sans-serif;\n  color: var(--neutral-700);\n}\n\n.memory-summary__updated {\n  font: 400 12px/18px \"SF Pro Text\", -apple-system, sans-serif;\n  color: var(--text-tertiary);\n}\n\n/* \"Top of mind\" list */\n.memory-item__title {\n  font: 600 15px/22px \"SF Pro Text\", -apple-system, sans-serif;\n  color: var(--text-primary);\n}\n\n.memory-item__updated {\n  font: 400 14px/20px \"SF Pro Text\", -apple-system, sans-serif;\n  color: var(--text-secondary);\n}",
    "jsx": "// Memory home, as returned by the Figma MCP for node 7188:1983. Trimmed to the\n// structure that matters — status bar and icon assets removed.\n//\n// Note the two bindings of text/secondary below: the intro falls back to #565c79,\n// the card heading to #3d456b. Same token, same frame, two values.\n\nexport default function MemoryHome() {\n  return (\n    <div className=\"bg-[var(--bg/canvas,white)] rounded-[48px] size-full\" data-node-id=\"7188:1983\">\n      <div className=\"absolute flex flex-col gap-[32px] left-0 right-0 top-[122px] px-[16px] pt-[24px] pb-[16px]\" data-node-id=\"7188:1988\" data-name=\"Content\">\n\n        <header className=\"flex flex-col gap-[4px] px-[8px]\" data-node-id=\"7188:1990\">\n          <p className=\"text-[24px] leading-[32px] font-['SF_Pro_Text:Semibold'] text-[color:var(--text/primary,#1a1f3c)]\" data-node-id=\"7188:1991\">\n            Memory\n          </p>\n          <p className=\"text-[length:var(--font/size/text-md,15px)] leading-[var(--font/lh/text-md,22px)] text-[color:var(--text/secondary,#565c79)]\" data-node-id=\"7188:1992\">\n            Memories are details you&rsquo;ve shared about your health, family, lifestyle, and\n            preferences. They help personalize PC Chat&trade; answers and you can update or\n            delete them anytime.\n          </p>\n        </header>\n\n        {/* Figma layer name: \"What I know about you\" — heading text says otherwise */}\n        <section\n          className=\"flex flex-col gap-[8px] w-[359px] rounded-[20px] border-2 border-[var(--new-neutrals/white,white)] bg-[var(--bg/surface,#f5f6fa)] p-[var(--space/16,16px)] backdrop-blur-[calc(var(--blur/glass-sm,20px)/2)]\"\n          data-node-id=\"7188:1993\"\n          data-name=\"What I know about you\"\n        >\n          <BrandMark className=\"size-[32px]\" />\n\n          <p className=\"text-[length:var(--font/size/text-lg,18px)] leading-[var(--font/lh/text-lg,28px)] text-[color:var(--text/secondary,#3d456b)]\" data-node-id=\"7188:1998\">\n            What you&rsquo;ve told PC Chat&trade;\n          </p>\n\n          {summary.paragraphs.map((text) => (\n            <p key={text} className=\"text-[length:var(--font/size/text-sm,14px)] leading-[var(--font/lh/text-sm,20px)] text-[color:var(--neutral/700,#3d456b)]\">\n              {text}\n            </p>\n          ))}\n\n          <p className=\"pt-[8px] text-[length:var(--font/size/text-xs,12px)] leading-[var(--font/lh/text-xs,18px)] text-[color:var(--text/tertiary,#717794)]\" data-node-id=\"7188:2002\">\n            Last updated {summary.updatedLabel}\n          </p>\n        </section>\n\n        {/* Groups: \"Top of mind\", \"Your current health\", … separated by 1px #dddfeb rules */}\n        {groups.map((group) => (\n          <section key={group.title} className=\"flex flex-col gap-[8px]\">\n            <h2 className=\"px-[8px] text-[length:var(--font/size/text-md,15px)] leading-[var(--font/lh/text-md,22px)] text-[color:var(--text/primary,#1a1f3c)]\">\n              {group.title}\n            </h2>\n\n            <ul className=\"flex flex-col\">\n              {group.items.map((item) => (\n                <li key={item.id} className=\"flex min-h-[40px] items-center p-[8px]\">\n                  <div className=\"flex flex-1 flex-col gap-[2px]\">\n                    <p className=\"truncate text-[15px] leading-[var(--font/lh/text-md,22px)] text-[color:var(--text/primary,#1a1f3c)]\">\n                      {item.text}\n                    </p>\n                    <p className=\"text-[length:var(--font/size/text-xs,12px)] leading-[var(--font/lh/text-xs,18px)] text-[color:var(--new-neutrals/darkest-grey,#565c79)]\">\n                      {item.updatedLabel}\n                    </p>\n                  </div>\n                </li>\n              ))}\n            </ul>\n          </section>\n        ))}\n      </div>\n\n      {/* Search is a pinned button over a white scrim, not an inline field */}\n      <div className=\"absolute bottom-0 left-0 h-[140px] w-[393px]\" data-node-id=\"7340:57517\" data-name=\"Search with overlay\">\n        <div className=\"absolute bottom-0 h-[140px] w-full bg-gradient-to-b from-white/0 via-white/70 to-white/90\" />\n        <button className=\"absolute left-[24px] top-[64px] flex h-[44px] w-[345px] items-center gap-[8px] rounded-full border-2 border-white bg-[var(--bg/white-subtle,rgba(255,255,255,0.4))] px-[16px]\" data-node-id=\"7340:57519\">\n          <MagnifyingGlass className=\"size-[16px]\" />\n          <span className=\"text-[length:var(--font/size/text-md,15px)] text-[color:var(--text/tertiary,#717794)]\">Search</span>\n        </button>\n      </div>\n    </div>\n  );\n}",
    "swiftui": "// Hand-translated from the extracted tokens — verify against the iOS UI kit.\n\nstruct MemoryHome: View {\n    let summary: MemorySummary\n    let groups: [MemoryGroup]\n\n    var body: some View {\n        ScrollView {\n            VStack(alignment: .leading, spacing: 24) {\n                VStack(alignment: .leading, spacing: 8) {\n                    Text(\"Memory\")\n                        .font(.system(size: 24, weight: .semibold))\n                    Text(\"Memories are details you've shared about your health, family, lifestyle, and preferences. They help personalize PC Chat\\u{2122} answers and you can update or delete them anytime.\")\n                        .font(.system(size: 15))\n                        .foregroundStyle(Color.textSecondary)\n                }\n\n                MemorySummaryCard(summary: summary)\n\n                ForEach(groups) { group in\n                    MemoryGroupSection(group: group)\n                }\n            }\n            .padding(.horizontal, 24)\n        }\n        .background(Color.bgSurface)\n    }\n}"
  },
