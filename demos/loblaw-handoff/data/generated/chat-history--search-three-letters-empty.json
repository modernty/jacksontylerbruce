  "looseEnds": [
    {
      "kind": "behaviour",
      "severity": "medium",
      "title": "The correction is applied but never announced",
      "detail": "The spell-check frame searches for “medications” while the field still reads “mdeications”, and nothing on screen says a correction happened. The user cannot tell these are not results for what they typed, and has no way back to the literal query.",
      "nodes": [
        "8152:71684",
        "8152:71688"
      ],
      "ask": "Add a line naming the spelling used, with a way to search the original instead — or state that silent correction is intended."
    },
    {
      "kind": "behaviour",
      "severity": "medium",
      "title": "Nothing marks the threshold between the bands",
      "detail": "One letter is inert, two letters fire a query. The screens differ only in the query text, so the rule lives in the frame names rather than in anything drawn. A developer reading the screens alone cannot tell where the cut is.",
      "nodes": [
        "8152:71107",
        "8152:71123"
      ],
      "ask": "Confirm the threshold is two characters, and whether a two-letter whole-word match (BP, ER) is in or out for MVP."
    },
    {
      "kind": "scope",
      "severity": "low",
      "title": "No cancelled or dismissed state is drawn",
      "detail": "Cancel sits in the bar on every frame and no frame shows what it returns to. The keyboard is up in all eight, so the list-with-keyboard-dismissed case is undrawn too.",
      "nodes": [
        "8152:70800"
      ],
      "ask": "Does Cancel clear the query and stay, or leave search entirely?"
    }
  ],
  "constraints": [],
  "code": {
    "css": "/* Search replaces the title bar rather than sitting under it. */\n.search-bar {\n  position: absolute;\n  inset: 0 0 auto 0;\n  height: 124px;\n  display: flex;\n  align-items: flex-end;\n  gap: 8px;\n  padding: 12px 24px;\n}\n\n.search-bar__field {\n  flex: 1;\n  height: 46px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 15px 16px;\n  border-radius: 999px;\n}\n\n/* The results area starts where the bar ends and runs to the keyboard. */\n.search-results { position: absolute; top: 124px; left: 0; right: 0; padding: 16px; }\n.search-results__spinner { height: 411px; display: grid; place-items: center; }",
    "jsx": "// Eight frames, one screen. What differs is the query and which of four bodies\n// the results area holds:\n//\n//   prompt   — the fixed line, shown under the threshold and alongside an empty result\n//   spinner  — while the query runs\n//   empty    — “No chats found”, with the prompt repeated beneath it\n//   results  — the Chat history row, with the matched run in Semibold\n//\n// The keyboard is up in all eight: none of them is a state you reach by dismissing it.",
    "swiftui": "// The bar is a search field and a Cancel, bottom-aligned in a 124pt header.\nstruct HistorySearchBar: View {\n  @Binding var query: String\n  var onCancel: () -> Void\n\n  var body: some View {\n    HStack(spacing: 8) {\n      HStack(spacing: 8) {\n        Image(systemName: \"magnifyingglass\")\n        TextField(\"Search history\", text: $query)\n      }\n      .padding(.horizontal, 16)\n      .frame(height: 46)\n      .background(Capsule().fill(Color(.systemGray6)))\n\n      Button(\"Cancel\", action: onCancel)\n        .font(.system(size: 12, weight: .medium))\n    }\n    .padding(.horizontal, 24)\n    .frame(height: 124, alignment: .bottom)\n  }\n}"
  },
