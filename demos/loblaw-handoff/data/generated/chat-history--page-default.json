  "figmaNodeId": "8156:74666",
  "summary": "The everyday case: four conversations under a counted heading, with Search and Select in the nav. The pill that used to sit at the foot of the list is gone.",
  "looseEnds": [
    {
      "kind": "missing-content",
      "severity": "high",
      "title": "The memory count no longer renders anywhere",
      "detail": "Three of the twelve rows across these frames still carry a Metadata frame holding a bullet and the words '3 memories created'. Both are switched off, and the other nine rows do not carry the frame at all — so no row reports what a conversation contributed. This is the one place in the product that reported it, and the copy also changed from 'N memories saved' to a hardcoded '3 memories created'.",
      "nodes": [
        "8156:74693",
        "8156:74695",
        "8156:74696"
      ],
      "ask": "Is the memory count dropped for launch, or switched off by hand? If it is staying, it needs a rule for the number and for rows that produced none."
    },
    {
      "kind": "geometry",
      "severity": "low",
      "title": "Rows come in two shapes on the same list",
      "detail": "Row 2 holds a Metadata frame; rows 1, 3 and 4 hold a bare timestamp text node. They render identically, so a developer reading the layer tree sees a structural difference that carries no meaning.",
      "nodes": [
        "8156:74686",
        "8156:74693"
      ],
      "ask": "Flatten the rows to one shape, or keep the Metadata frame on all four."
    },
    {
      "kind": "inconsistent-geometry",
      "severity": "low",
      "title": "The pill group sits 4px further left here than on the same nav elsewhere",
      "detail": "Search and Select are the same two components throughout, but the group that holds them is 275 wide with an 8px gap on the History frames and 271 wide with a 4px gap on the Deleting frames and on Memory. Both end flush at x=369, so the difference shows up on the left edge.",
      "nodes": [
        "8156:76056"
      ],
      "ask": "Pick one gap. 4px matches Memory, which a developer will build from the same component."
    }
  ],
