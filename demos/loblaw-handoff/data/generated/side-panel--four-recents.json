  "code": {
    "css": "/* The side panel on its own — 330×852, no conversation behind it. */\n.side-panel {\n  width: 330px;\n  height: 852px;\n  padding-top: 52px;\n  border-radius: 40px;\n  background: var(--bg-canvas);\n  box-shadow: 0 4px 20px 0 rgba(113, 117, 142, 0.25);\n}\n\n.side-panel__content {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n  padding: 24px 8px;\n}\n\n/* Five nav rows at 46 high, so the list below starts 64px lower than it did. */\n.recents { display: flex; flex-direction: column; gap: 4px; }\n\n.recents__item {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  min-height: 40px;\n  padding: 8px;\n  border-radius: 16px;\n}\n\n.recents__title {\n  font: 400 15px/22px var(--font-ui);\n  color: var(--text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}",
    "jsx": "// Rendered from src/components/screens/side-panel-page.tsx rather than served as a\n// screenshot. Every Figma node is an element carrying data-node-id, so the measurements\n// on the Designs tab come from the live DOM.\n//\n// Five nav rows now — Settings last — at 46 high on 20px icons.\n//\n// The row is the same component the Chat history page uses — the panel got its overflow\n// control back, and the `Tag + Text` wrapper with it:\n\n<RecentRow row={row} />\n\n// Half the rows sit inside an extra wrapper frame in the file and half do not. The\n// wrapper is drawn when it exists, so the layer tree here matches the one in Figma.",
    "swiftui": "// The panel is a fixed 330pt surface, not a sheet.\nstruct SidePanel: View {\n  var body: some View {\n    VStack(alignment: .leading, spacing: 24) {\n      HStack(spacing: 8) {\n        Image(\"pc-chat-mark\").frame(width: 24, height: 24)\n        Text(\"PC Chat\").font(.custom(\"Poppins-SemiBold\", size: 20))\n      }\n      .padding(.horizontal, 24)\n      .padding(.top, 24)\n\n      VStack(spacing: 0) {\n        NavItem(icon: \"square.and.pencil\", label: \"New chat\")\n        NavItem(icon: \"bubble.left\", label: \"Chat history\")\n        NavItem(icon: \"book\", label: \"Memory\")\n        NavItem(icon: \"gear\", label: \"Settings\")\n      }\n\n      VStack(alignment: .leading, spacing: 8) {\n        Text(\"Recents\").font(.system(size: 15, weight: .semibold))\n          .padding(.horizontal, 8)\n        VStack(spacing: 4) { ForEach(recents) { RecentRow(row: $0) } }\n      }\n    }\n    .padding(8)\n    .frame(width: 330, height: 852, alignment: .top)\n    .background(Color.white)\n    .clipShape(RoundedRectangle(cornerRadius: 40))\n  }\n}"
  },
