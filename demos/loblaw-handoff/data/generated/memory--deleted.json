    {
      "kind": "behaviour",
      "severity": "medium",
      "title": "The toast carries an Undo that is switched off",
      "detail": "The Toast component has an Action slot holding “Undo”. This frame hides it, so the only control is the dismiss. Delete is otherwise a one-way door with a dialog as its only gate.",
      "nodes": [
        "I8156:265992;7102:26288",
        "I8156:265992;7102:26289"
      ],
      "ask": "Is Undo coming, or is the dialog the whole protection? If it is coming, how long does it stay?"
    },
    {
      "kind": "behaviour",
      "severity": "low",
      "title": "The toast sits over the summary card",
      "detail": "It lands at y=60, which on a scrolled list covers the card rather than the rows the delete changed. Nothing says whether the list scrolls to the affected group first.",
      "nodes": [
        "8156:265992"
      ],
      "ask": "Does the list move to show what changed, or does the toast do all the telling?"
    },
    {
      "kind": "inconsistency",
      "severity": "low",
      "title": "The summary card is headed “What you’ve told me” here",
      "detail": "Every other Memory frame heads it “What you’ve told PC Chat™”, and uses the brand mark rather than a placed image for the icon.",
      "nodes": [
