  "code": {
    "css": "/* The toast: 361 wide inside the 393 frame, 8px padding, 24 in to the message. */\n.toast {\n  position: absolute;\n  inset: 60px 16px auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  height: 56px;\n  padding: 8px;\n  border-radius: 32px;\n  background: var(--bg-surface-translucent);\n  backdrop-filter: blur(8px);\n  box-shadow: 0 4px 20px 0 rgba(113, 117, 142, 0.25);\n}\n\n.toast__message { padding-left: 16px; font: var(--text-xs-semibold); }\n.toast__dismiss { width: 40px; height: 40px; border-radius: 50%; background: rgb(255 255 255 / 0.4); }",
    "jsx": "// The post-delete state. The toast is the same component the Chat settings page\n// uses — message, an Action slot, and a dismiss — with the Action switched off here.\n//\n// A memory drawn in two groups leaves both when it goes, which is why Top of mind is\n// two rows shorter rather than one.\n\n<Toast message=\"Memory deleted\" onDismiss={dismiss} />",
    "swiftui": "// Toast sits above the list, not over the tab bar.\nstruct MemoryToast: View {\n  let message: String\n  var onDismiss: () -> Void\n\n  var body: some View {\n    HStack(spacing: 8) {\n      Text(message)\n        .font(.system(size: 12, weight: .semibold))\n        .padding(.leading, 16)\n      Spacer(minLength: 0)\n      Button(action: onDismiss) {\n        Image(systemName: \"xmark\").frame(width: 40, height: 40)\n      }\n      .background(Circle().fill(.white.opacity(0.4)))\n    }\n    .padding(8)\n    .frame(height: 56)\n    .background(Capsule().fill(.thinMaterial))\n    .padding(.horizontal, 16)\n  }\n}"
  },
