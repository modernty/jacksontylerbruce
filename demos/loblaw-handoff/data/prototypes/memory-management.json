    "intro": {
      "text": "Memories are health details you've shared about yourself and your family members. They help personalize PC Chat™ answers and you can update or delete them anytime.",
      "node": "8156:263852",
      "source": "figma-node"
    },
    "summaryHeading": {
      "text": "What you’ve told PC Chat™",
      "node": "8156:263864",
      "source": "figma-node"
    },
    "summaryParagraphs": [
      {
        "text": "You're 8 weeks pregnant. You've had a cough and fever for a few days, and you're working on managing your blood pressure — you take lisinopril for it, and there's a history of high blood pressure in your family. You have a peanut allergy. Your 8-year-old son has a cold right now.",
        "node": "8156:263865",
        "source": "figma-node"
      },
      {
        "text": "You live in Ontario and see Dr. Sara Smith as your family physician. You've had a COVID-19 vaccine, and about a month ago you had an MRI for some liver discomfort.",
        "node": "8156:263866",
        "source": "figma-node"
      }
    ],
    "summaryUpdated": {
      "text": "Last updated today",
      "node": "8156:263868",
