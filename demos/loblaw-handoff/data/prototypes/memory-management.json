  "moments": [
    {
      "id": "browse",
      "label": "Browse",
      "screen": "memory--home",
      "anchor": "8156:263855",
      "note": "Seven groups under a summary of what the assistant has been told. Two memories appear twice — Top of mind repeats them."
    },
    {
      "id": "selecting",
      "label": "Select",
      "screen": "memory--selecting",
      "anchor": "8156:264911",
      "note": "A 24px checkbox arrives at the left of every row and the text indents 40 to make room. The bar swaps Search and Select for Select all and Cancel, and a counted Delete appears. The tick follows the memory, so one drawn in two groups shows checked twice and still counts once."
    },
    {
      "id": "detail",
      "label": "Open a memory",
      "screen": "memory--viewing",
      "anchor": "8156:266748",
      "note": "A pushed page with its own back and title, not a drawer. The fields are rows on a card, and Delete sits fixed at the foot."
    },
    {
      "id": "confirm",
      "label": "Confirm the delete",
      "screen": "memory--deleting",
      "anchor": "8156:266801",
      "note": "The dialog names what deleting does not take: the detail can be saved again, and chat history stays. There is no longer an option to delete the originating chat."
    },
    {
      "id": "deleted",
      "label": "After deletion",
      "screen": "memory--deleted",
      "anchor": "8156:265992",
      "note": "The list comes back with a toast at the top saying “Memory deleted”. The component carries an Undo beside the message; this frame switches it off, so the dismiss is the only control."
    }
  ],
