    "dialogTitle": {
      "text": "Delete this memory?",
      "node": "8156:266804",
      "source": "figma-node"
    },
    "dialogBody": {
      "text": "The memory will be permanently deleted. If you share the detail again, we’ll save it as a new memory. Your chat history stays.",
